<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" >
    <link href="/main.css" rel="stylesheet">
</head>
<body class="grey-bg">

  <%- include('nav') %>
  <div class="white-bg">
  <% for (let i = 0; i < 글목록.length; i++){ %>
    <div class="list-box">
      <h4>
        <a href="/detail/<%= 글목록[i].id %>">
          <%= 글목록[i].email %>
        </a>
        <a href="/edit/<%= 글목록[i].id %>">✏️</a>
        <span class="delete" data-id="<%= 글목록[i].id %>">🗑️</span>
      </h4>
      <p><%= 글목록[i].nickname %></p>
    </div>
  <% } %>
    

  <nav aria-label="Page navigation example">
    <ul class="pagination">
      <li class="page-item <%= startPage === 1 ? 'disabled' : '' %>">
        <% if (startPage === 1) { %>
          <span class="page-link">Previous</span>
        <% } else { %>
          <a class="page-link" href="/list/<%= startPage - 1 %>">
            Previous
          </a>
        <% } %>
      </li>

      <% for (let i = startPage; i <= endPage; i++) { %>
        <li class="page-item <%= page === i ? 'active' : '' %>">
          <a class="page-link" href="/list/<%= i %>"><%= i %></a>
        </li>
      <% } %>

      <li class="page-item">
        <a class="page-link" href="/list/<%= endPage + 1 %>">Next</a>
      </li>
    </ul>
  </nav>


</div>

<script>
  document.querySelectorAll('.delete').forEach((deleteBtn, i) => {
    deleteBtn.addEventListener('click', function(){
      fetch(
        '/delete?docid=' + deleteBtn.dataset.id,
        {
          method: 'DELETE',
        }  
    )
  })
})
</script>

</body>
</html> 