<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%= JSON.stringify(result)  %>
    <form class="form-box" action="/edit" method="POST">
        <h4>글쓰기</h4>
        <input name="id" type="hidden" value="<%= result[0].id %>">
        <input name="nickname" placeholder="닉네임" value="<%= result[0].nickname %>">
        <input name="email" placeholder="이메일" value="<%= result[0].email %>">
        <button type="submit">전송</button>
    </form> 

</body>
</html>